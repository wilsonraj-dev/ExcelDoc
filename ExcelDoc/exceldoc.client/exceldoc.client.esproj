<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.4902498">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Publish restores with npm ci below; developers restore explicitly as documented. -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- Avoid a network-dependent audit on every .NET build; run npm audit explicitly in CI. -->
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
    <BuildCommand>npm run build -- --configuration production</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\exceldoc.client\browser\</BuildOutputFolder>
  </PropertyGroup>

  <!-- The JavaScript SDK then registers BuildOutputFolder in the ASP.NET static-assets manifest. -->
  <Target Name="RestoreAngularForPublish" BeforeTargets="_RunNpmCommandForPublishAssets">
    <Message Importance="high" Text="Restoring locked Angular dependencies for IIS publish..." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci --no-audit --no-fund" />
  </Target>

  <ItemGroup>
    <Folder Include="src\app\core\models\" />
    <Folder Include="src\assets\i18n\" />
  </ItemGroup>
</Project>
